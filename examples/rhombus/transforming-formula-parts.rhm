#lang rhombus

// The SCENE-O formula-part transformation API is an ordinary Racket value and
// function interface that Rhombus can import directly.
import:
  "animate" open
  "animate/render" open

module main:
  fun make_part(name, source, x):
    #{latex-formula-part}(
      source,
      ~#{name}: name,
      ~#{center}: vec2(x, 0),
      ~#{mode}: #'inline,
      ~#{font-size}: 2/5,
      ~#{vertical-alignment}: #'baseline
    )

  def source = #{formula-assembly}(
    [make_part(#'a-square, "a^2", -12/5),
     make_part(#'plus, "+", -6/5),
     make_part(#'b-square, "b^2", 0),
     make_part(#'equals, "=", 6/5),
     make_part(#'c-square, "c^2", 12/5)],
    ~#{id}: #'equation,
    ~#{center}: vec2(-6, 0),
    ~#{rotation}: -1/16,
    ~#{scale}: 4/5,
    ~#{opacity}: 4/5
  )

  def destination = #{formula-assembly}(
    [make_part(#'c-square, "c^2", -12/5),
     make_part(#'minus, "-", -6/5),
     make_part(#'a-square, "a^2", 0),
     make_part(#'equals, "=", 6/5),
     make_part(#'b-square, "b^2", 12/5)],
    ~#{id}: #'destination-template
  )

  def correspondence = #{formula-correspondence}(
    source,
    destination,
    [#{formula-part-match}(#'a-square, #'a-square),
     #{formula-part-match}(#'plus, #'minus),
     #{formula-part-match}(#'b-square, #'b-square),
     #{formula-part-match}(#'equals, #'equals)]
  )

  def background = rectangle(
    ~#{id}: #'background,
    ~#{width}: 9,
    ~#{height}: 3,
    ~#{fill}: "aliceblue",
    ~#{stroke}: "navy",
    ~#{stroke-width}: 3
  )

  def title = #{plain-text}(
    "Transform corresponding formula parts",
    ~#{id}: #'title,
    ~#{center}: vec2(0, 1),
    ~#{font-size}: 1/3,
    ~#{font-family}: #'swiss,
    ~#{font-weight}: #'bold,
    ~#{color}: "navy"
  )

  def initial = #{scene-add}(#{make-scene}(), background, title)

  def entrance = #{scene-play}(
    initial,
    #{move-to}(source, vec2(0, -1/3)),
    #{rotate-to}(source, 0),
    #{scale-to}(source, 1),
    #{fade-in}(source),
    ~#{duration}: 2
  )

  def transformation = #{scene-play}(
    entrance,
    #{transform-formula-parts}(correspondence),
    #{move-to}(source, vec2(0, -1/2)),
    #{rotate-to}(source, 1/24),
    #{scale-to}(source, 6/5),
    #{fade-to}(source, 1),
    ~#{duration}: 2
  )

  def demo = #{scene-wait}(transformation, 1/2)

  def frame_paths = #{render-frames!}(
    demo,
    "frames",
    ~#{fps}: 30
  )
