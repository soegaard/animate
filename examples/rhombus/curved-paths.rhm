#lang rhombus

// The SCENE-G cubic path API consists of ordinary Racket values and functions
// that Rhombus can import directly.
import:
  "../main.rkt" open

module main:
  def wave_path = #{cubic-bezier-path}(
    vec2(-4, 0),
    [#{cubic-bezier-path-segment}(
       vec2(-3, 2),
       vec2(-1, 2),
       origin
     ),
     #{cubic-bezier-path-segment}(
       vec2(1, -2),
       vec2(3, -2),
       vec2(4, 0)
     )]
  )

  def loop_path = #{cubic-bezier-path}(
    vec2(0, 2),
    [#{cubic-bezier-path-segment}(
       vec2(2, 2),
       vec2(3, 1),
       vec2(3, 0)
     ),
     #{cubic-bezier-path-segment}(
       vec2(3, -1),
       vec2(2, -2),
       vec2(0, -2)
     ),
     #{cubic-bezier-path-segment}(
       vec2(-2, -2),
       vec2(-3, -1),
       vec2(-3, 0)
     ),
     #{cubic-bezier-path-segment}(
       vec2(-3, 1),
       vec2(-2, 2),
       vec2(0, 2)
     )],
    ~#{closed?}: #true
  )

  def wave = #{make-path-visual}(
    wave_path,
    ~#{id}: #'wave,
    ~#{center}: vec2(0, 2),
    ~#{stroke}: "crimson",
    ~#{stroke-width}: 5
  )

  def loop = #{make-path-visual}(
    loop_path,
    ~#{id}: #'loop,
    ~#{center}: vec2(0, -2),
    ~#{fill}: "cornflowerblue",
    ~#{stroke}: "navy",
    ~#{stroke-width}: 3
  )

  def created = #{scene-play}(
    #{make-scene}(),
    create(wave),
    create(loop),
    ~#{duration}: 2
  )

  def transformed = #{scene-play}(
    created,
    #{move-to}(wave, vec2(0, -2)),
    #{rotate-by}(wave, 1/2),
    #{move-to}(loop, vec2(0, 2)),
    #{rotate-by}(loop, -1/2),
    #{scale-to}(loop, vec2(3/4, 5/4)),
    ~#{duration}: 3/2
  )

  def removed = #{scene-play}(
    transformed,
    uncreate(wave),
    ~#{duration}: 1
  )

  def demo = #{scene-wait}(removed, 1/2)

  def frame_paths = #{render-frames!}(
    demo,
    "frames",
    ~#{fps}: 30
  )
