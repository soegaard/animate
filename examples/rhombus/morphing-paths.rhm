#lang rhombus

// The SCENE-H path-morph API consists of ordinary Racket values and functions
// that Rhombus can import directly.
import:
  "../main.rkt" open

module main:
  def panel_source_path = #{polygon-path}(
    [vec2(-2, -1),
     vec2(2, -1),
     vec2(2, 1),
     vec2(-2, 1)]
  )

  def panel_destination_path = #{polygon-path}(
    [vec2(0, -2),
     vec2(3, 0),
     vec2(0, 2),
     vec2(-3, 0)]
  )

  def wave_source_path = #{cubic-bezier-path}(
    vec2(-3, 0),
    [#{cubic-bezier-path-segment}(
       vec2(-2, 2),
       vec2(-1, 2),
       origin
     ),
     #{cubic-bezier-path-segment}(
       vec2(1, -2),
       vec2(2, -2),
       vec2(3, 0)
     )]
  )

  def wave_destination_path = #{cubic-bezier-path}(
    vec2(-3, -1),
    [#{cubic-bezier-path-segment}(
       vec2(-2, -1),
       vec2(-1, 3),
       vec2(0, 3)
     ),
     #{cubic-bezier-path-segment}(
       vec2(1, 3),
       vec2(2, -1),
       vec2(3, -1)
     )]
  )

  def panel = #{make-path-visual}(
    panel_source_path,
    ~#{id}: #'panel,
    ~#{center}: vec2(0, 2),
    ~#{fill}: "cornflowerblue",
    ~#{stroke}: "navy",
    ~#{stroke-width}: 3
  )

  def wave = #{make-path-visual}(
    wave_source_path,
    ~#{id}: #'wave,
    ~#{center}: vec2(0, -2),
    ~#{stroke}: "crimson",
    ~#{stroke-width}: 5
  )

  def morphed = #{scene-play}(
    #{scene-add}(#{make-scene}(), panel, wave),
    #{morph-to}(panel, panel_destination_path),
    #{rotate-by}(panel, 1/2),
    #{morph-to}(wave, wave_destination_path),
    #{scale-to}(wave, vec2(4/3, 3/4)),
    ~#{duration}: 2
  )

  def demo = #{scene-wait}(morphed, 1/2)

  def frame_paths = #{render-frames!}(
    demo,
    "frames",
    ~#{fps}: 30
  )
