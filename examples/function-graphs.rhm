#lang rhombus

// The SCENE-R axes, sampled-function, path, and timeline APIs are ordinary
// Racket values and functions that Rhombus can import directly.
import:
  "../main.rkt" open

module main:
  def coordinate_axes = axes(
    ~#{id}: #'coordinate-axes,
    ~#{x-range}: axis_range(-5, 5, 1),
    ~#{y-range}: axis_range(-3, 3, 1),
    ~#{x-length}: 10,
    ~#{y-length}: 6,
    ~#{stroke}: "navy",
    ~#{stroke-width}: 3
  )

  fun cubic(x):
    x * (x - 2) * (x + 2) / 4

  fun reciprocal(x):
    if x == 0
    | #false
    | 1 / x

  def cubic_graph = #{function-graph}(
    coordinate_axes,
    cubic,
    ~#{id}: #'cubic-graph,
    ~#{sample-count}: 241,
    ~#{stroke}: "crimson",
    ~#{stroke-width}: 4
  )

  def reciprocal_graph = #{function-graph}(
    coordinate_axes,
    reciprocal,
    ~#{id}: #'reciprocal-graph,
    ~#{sample-count}: 241,
    ~#{max-jump}: 3,
    ~#{opacity}: 4/5,
    ~#{stroke}: "seagreen",
    ~#{stroke-width}: 4
  )

  def x_label = #{visual-place-right-of}(
    #{plain-text}(
      "x",
      ~#{id}: #'x-label,
      ~#{font-size}: 2/5,
      ~#{font-family}: #'roman,
      ~#{font-style}: #'italic,
      ~#{color}: "navy"
    ),
    coordinate_axes,
    ~#{gap}: 1/5
  )

  def y_label = #{visual-place-above}(
    #{plain-text}(
      "y",
      ~#{id}: #'y-label,
      ~#{font-size}: 2/5,
      ~#{font-family}: #'roman,
      ~#{font-style}: #'italic,
      ~#{color}: "navy"
    ),
    coordinate_axes,
    ~#{gap}: 1/5
  )

  def entrance = #{scene-play}(
    #{make-scene}(),
    #{fade-in}(coordinate_axes),
    #{fade-in}(x_label),
    #{fade-in}(y_label),
    create(cubic_graph),
    create(reciprocal_graph),
    ~#{duration}: 5/2
  )

  def emphasis = #{scene-play}(
    entrance,
    #{fade-to}(reciprocal_graph, 1/3),
    ~#{duration}: 1
  )

  def demo = #{scene-wait}(emphasis, 1/2)

  def frame_paths = #{render-frames!}(
    demo,
    "frames",
    ~#{fps}: 30
  )
