{
  "schema": "animate-complete-examples-v1",
  "families": {
    "main": {
      "manifest": "scribblings/figures/illustrations.json",
      "schema": "animate-manual-illustrations-v1"
    },
    "learning": {
      "manifest": "scribblings/figures/learning-r4/manifest.json",
      "schema": "animate-manual-learning-frames-v1"
    },
    "3d": {
      "manifest": "scribblings/figures/3d-r3/manifest.json",
      "schema": "animate-manual-3d-frames-v1"
    }
  },
  "entries": [
    {
      "id": "moving-circle",
      "title": "A moving circle",
      "chapter": "moving-circle.scrbl",
      "sources": [
        "scribblings/examples/moving-circle.rkt"
      ],
      "requirements": [
        "Animate; FFmpeg for MP4 output"
      ],
      "optional": [],
      "checks": [
        {
          "source": "scribblings/examples/moving-circle.rkt",
          "binding": "animation",
          "kind": "scene",
          "duration": 1.5
        }
      ],
      "strips": [
        {
          "id": "motion",
          "family": "main",
          "key": "circle-motion",
          "select": [
            0,
            1,
            2,
            3,
            4
          ],
          "note": "The one-second movement. The exported animation adds a half-second hold after it."
        }
      ],
      "runs": [
        {
          "id": "movie",
          "command": "racket \\\n  -e '(require animate/render \"scribblings/examples/moving-circle.rkt\")' \\\n  -e '(render-frames! animation \"slides-output/complete-examples/moving-circle/frames\" #:fps 30)' \\\n  -e '(encode-mp4! \"slides-output/complete-examples/moving-circle/frames\" \"slides-output/complete-examples/moving-circle/moving-circle.mp4\" #:fps 30)'",
          "inputs": [
            "scribblings/examples/moving-circle.rkt"
          ],
          "output": "slides-output/complete-examples/moving-circle/moving-circle.mp4",
          "note": "Writes numbered PNGs, then encodes them as an MP4. This simple two-step route renders in one process."
        }
      ]
    },
    {
      "id": "function-graph",
      "title": "Draw and move a function graph",
      "chapter": "function-graph.scrbl",
      "sources": [
        "scribblings/examples/first-function-graph.rkt"
      ],
      "requirements": [
        "Animate; no formula typesetter; FFmpeg for MP4 output"
      ],
      "optional": [],
      "checks": [
        {
          "source": "scribblings/examples/first-function-graph.rkt",
          "binding": "film",
          "kind": "scene",
          "duration": 3
        },
        {
          "source": "scribblings/examples/first-function-graph.rkt",
          "binding": "moving-diagram",
          "kind": "scene",
          "duration": 2
        }
      ],
      "strips": [
        {
          "id": "draw",
          "family": "learning",
          "key": "draw-graph",
          "select": [
            0,
            2,
            4
          ],
          "note": "Reveal the curve, then hold the finished graph."
        },
        {
          "id": "move",
          "family": "learning",
          "key": "move-graph",
          "select": [
            0,
            1,
            2
          ],
          "note": "A separate animation: the completed graph and its axes move together."
        }
      ],
      "runs": [
        {
          "id": "movie",
          "command": "racket \\\n  -e '(require animate/render \"scribblings/examples/first-function-graph.rkt\")' \\\n  -e '(render-frames! film \"slides-output/complete-examples/function-graph/frames\" #:fps 30)' \\\n  -e '(encode-mp4! \"slides-output/complete-examples/function-graph/frames\" \"slides-output/complete-examples/function-graph/function-graph.mp4\" #:fps 30)'",
          "inputs": [
            "scribblings/examples/first-function-graph.rkt"
          ],
          "output": "slides-output/complete-examples/function-graph/function-graph.mp4",
          "note": "Writes numbered PNGs, then encodes them as an MP4. This simple two-step route renders in one process."
        },
        {
          "id": "move-movie",
          "command": "racket \\\n  -e '(require animate/render \"scribblings/examples/first-function-graph.rkt\")' \\\n  -e '(render-frames! moving-diagram \"slides-output/complete-examples/moving-graph/frames\" #:fps 30)' \\\n  -e '(encode-mp4! \"slides-output/complete-examples/moving-graph/frames\" \"slides-output/complete-examples/moving-graph/moving-graph.mp4\" #:fps 30)'",
          "inputs": [
            "scribblings/examples/first-function-graph.rkt"
          ],
          "output": "slides-output/complete-examples/moving-graph/moving-graph.mp4",
          "note": "Writes numbered PNGs, then encodes them as an MP4. This simple two-step route renders in one process."
        }
      ]
    },
    {
      "id": "slide-lesson",
      "title": "A complete slide lesson",
      "chapter": "slide-lesson.scrbl",
      "sources": [
        "scribblings/examples/slide-lesson.rkt",
        "scribblings/examples/project.rkt"
      ],
      "requirements": [
        "Animate Slides; FFmpeg for MP4 output"
      ],
      "optional": [],
      "checks": [
        {
          "source": "scribblings/examples/slide-lesson.rkt",
          "binding": "film",
          "kind": "storyboard",
          "duration": 19.6
        },
        {
          "source": "scribblings/examples/project.rkt",
          "binding": "lesson-project",
          "kind": "project",
          "duration": null
        }
      ],
      "strips": [
        {
          "id": "lesson",
          "family": "main",
          "key": "function-lesson",
          "select": [
            0,
            1,
            2
          ],
          "note": "Opening, worked input, and recap. These times belong to the complete storyboard."
        }
      ],
      "runs": [
        {
          "id": "movie",
          "command": "racket slides/render-example.rkt --workers 10 \\\n  --output slides-output/complete-examples/slide-lesson \\\n  scribblings/examples/slide-lesson.rkt",
          "inputs": [
            "slides/render-example.rkt",
            "scribblings/examples/slide-lesson.rkt"
          ],
          "output": "slides-output/complete-examples/slide-lesson/slide-lesson.mp4",
          "note": "Uses the existing shared-worker slide runner. Add --frames to write PNGs without encoding an MP4."
        },
        {
          "id": "project",
          "command": "raco animate render scribblings/examples/project.rkt lesson-project",
          "inputs": [
            "scribblings/examples/project.rkt",
            "scribblings/examples/slide-lesson.rkt"
          ],
          "output": "slides-output/manual-videos/function-lesson.mp4",
          "note": "An alternative to the command above. The project file keeps the render settings beside the lesson source."
        }
      ]
    },
