    {
      "id": "spatial-lesson",
      "title": "A 3D lesson in three files",
      "chapter": "spatial-lesson.scrbl",
      "sources": [
        "scribblings/examples/first-spatial-picture.rkt",
        "scribblings/examples/spatial-motion.rkt",
        "scribblings/examples/spatial-slides.rkt"
      ],
      "requirements": [
        "Animate 3D and Slides; software rendering; FFmpeg for MP4 output"
      ],
      "optional": [
        "3d"
      ],
      "checks": [
        {
          "source": "scribblings/examples/first-spatial-picture.rkt",
          "binding": "still",
          "kind": "scene",
          "duration": 0
        },
        {
          "source": "scribblings/examples/spatial-motion.rkt",
          "binding": "lesson",
          "kind": "scene",
          "duration": 6
        },
        {
          "source": "scribblings/examples/spatial-slides.rkt",
          "binding": "captioned-lesson",
          "kind": "scene",
          "duration": 8
        },
        {
          "source": "scribblings/examples/spatial-slides.rkt",
          "binding": "film",
          "kind": "storyboard",
          "duration": 9
        }
      ],
      "strips": [
        {
          "id": "lesson",
          "family": "3d",
          "key": "lesson",
          "select": [
            0,
            2,
            4
          ],
          "note": "The six-second native Scene: turn the object, then orbit its camera."
        },
        {
          "id": "labels",
          "family": "3d",
          "key": "captioned-lesson",
          "select": [
            0,
            2,
            4
          ],
          "note": "The captioned variant adds a two-second move before the same six-second sequence."
        },
        {
          "id": "slide",
          "family": "3d",
          "key": "slide-lesson",
          "select": [
            0,
            2,
            4
          ],
          "note": "The slide variant holds for one second, plays for six, then holds for two."
        }
      ],
      "runs": [
        {
          "id": "movie",
          "command": "racket slides/render-example.rkt --workers 10 \\\n  --output slides-output/complete-examples/spatial-lesson \\\n  scribblings/examples/spatial-slides.rkt",
          "inputs": [
            "slides/render-example.rkt",
            "scribblings/examples/spatial-slides.rkt"
          ],
          "output": "slides-output/complete-examples/spatial-lesson/spatial-slides.mp4",
          "note": "Uses the existing shared-worker slide runner. Add --frames to write PNGs without encoding an MP4."
        },
        {
          "id": "native-movie",
          "command": "racket \\\n  -e '(require animate/render \"scribblings/examples/spatial-motion.rkt\")' \\\n  -e '(render-frames! lesson \"slides-output/complete-examples/native-spatial-lesson/frames\" #:fps 30)' \\\n  -e '(encode-mp4! \"slides-output/complete-examples/native-spatial-lesson/frames\" \"slides-output/complete-examples/native-spatial-lesson/native-spatial-lesson.mp4\" #:fps 30)'",
          "inputs": [
            "scribblings/examples/spatial-motion.rkt"
          ],
          "output": "slides-output/complete-examples/native-spatial-lesson/native-spatial-lesson.mp4",
          "note": "Writes numbered PNGs, then encodes them as an MP4. This simple two-step route renders in one process."
        }
      ]
    },
