        },
        {
          "id": "preview",
          "command": "racket examples/source-block-hot-reload.rkt",
          "inputs": [
            "examples/source-block-hot-reload.rkt"
          ],
          "output": null,
          "note": "Opens the maintained interactive variant. This is a GUI action, not a movie render."
        }
      ]
